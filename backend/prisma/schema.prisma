generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum InventoryMovementType {
  PURCHASE
  ADJUSTMENT
  CONSUMPTION
  RETURN
  SALE
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  material    String
  category    String
  image       String?
  images      String[] @default([])
  features    String[] @default([])
  stock       Int      @default(10)
  featured    Boolean  @default(false)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  components  ProductComponent[]
  saleLines   SaleLine[]
}

model InventoryItem {
  id          String             @id @default(uuid())
  sku         String             @unique
  name        String
  category    String
  material    String?
  size        String?
  lengthCm    Decimal?           @db.Decimal(12, 3)
  thicknessMm Decimal?           @db.Decimal(12, 3)
  weightGrams Decimal?           @db.Decimal(12, 3)
  description String?
  image       String?
  images      String[]           @default([])
  unit        String             @default("unidad")
  stock       Decimal            @default(0) @db.Decimal(18, 6)
  minStock    Decimal            @default(0) @db.Decimal(18, 6)
  unitCost    Decimal            @default(0) @db.Decimal(18, 2)
  salePrice   Decimal            @default(0) @db.Decimal(18, 2)
  active      Boolean            @default(true)
  movements   InventoryMovement[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  components  ProductComponent[]
  saleLines   SaleLine[]
}

model InventoryMovement {
  id          String                @id @default(uuid())
  itemId      String
  type        InventoryMovementType
  quantity    Decimal @db.Decimal(18, 6)
  previousStock Decimal @db.Decimal(18, 6)
  resultingStock Decimal @db.Decimal(18, 6)
  unitCost    Decimal? @db.Decimal(18, 2)
  note        String?
  createdBy   String?
  createdAt   DateTime              @default(now())
  item        InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  saleId      String?
  sale        Sale? @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@index([itemId, createdAt])
}

model ProductComponent {
  productId String
  itemId String
  quantity Decimal @db.Decimal(18, 6)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  @@id([productId, itemId])
  @@index([itemId])
}

model Sale {
  id String @id @default(uuid())
  requestKey String @unique
  requestHash String
  customerName String
  customerPhone String
  occurredAt DateTime
  createdAt DateTime @default(now())
  createdBy String
  createdByName String
  currency String @default("COP")
  total Decimal @db.Decimal(18, 2)
  totalCost Decimal @db.Decimal(18, 2)
  note String?
  lines SaleLine[]
  movements InventoryMovement[]
  @@index([occurredAt])
}

model SaleLine {
  id String @id @default(uuid())
  saleId String
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  productId String?
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  itemId String?
  item InventoryItem? @relation(fields: [itemId], references: [id], onDelete: Restrict)
  name String
  sku String?
  unit String
  quantity Decimal @db.Decimal(18, 6)
  unitPrice Decimal @db.Decimal(18, 2)
  unitCost Decimal @db.Decimal(18, 6)
  total Decimal @db.Decimal(18, 2)
  totalCost Decimal @db.Decimal(18, 2)
  @@index([saleId])
}
